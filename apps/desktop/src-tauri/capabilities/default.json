{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TheStuu desktop shell — webview, native sidecar lifecycle (no DAW IPC mutation)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "thestuu-native",
          "sidecar": true,
          "args": true
        },
        {
          "name": "node",
          "cmd": "node",
          "args": true
        }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "thestuu-native",
          "sidecar": true,
          "args": true
        },
        {
          "name": "node",
          "cmd": "node",
          "args": true
        }
      ]
    }
  ]
}
