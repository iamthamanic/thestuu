{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheStuu",
  "version": "0.1.0",
  "identifier": "com.thestuu.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../dashboard",
    "devUrl": "http://127.0.0.1:3010",
    "beforeBuildCommand": "npm run build --prefix ../dashboard",
    "frontendDist": "../../dashboard/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "TheStuu",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "../../native-engine/build/thestuu-native"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
