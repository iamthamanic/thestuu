{
  "name": "thestuu-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "TheStuu – start always runs Native-Engine + Engine + Dashboard via CLI",
  "scripts": {
    "dev": "node apps/cli/bin/thestuu.js start",
    "start": "node apps/cli/bin/thestuu.js start",
    "dev:engine": "npm run start --prefix apps/engine",
    "dev:dashboard": "npm run dev --prefix apps/dashboard",
    "check:daw-authority": "bash scripts/check-daw-authority.sh",
    "test:daw-authority": "npm run test --prefix apps/engine",
    "qa:native-daw": "node scripts/qa-native-daw.mjs",
    "qa:legacy-daw": "node scripts/qa-legacy-daw-smoke.mjs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
